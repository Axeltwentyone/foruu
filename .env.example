# Copie ce fichier en .env.local (dev) et renseigne les mêmes variables dans Vercel (prod).

# Stockage de ses réponses (prod). Créer une base gratuite Upstash Redis
# (Vercel > Storage > Upstash) : les deux variables sont ajoutées automatiquement.
# En dev, sans ces variables, les réponses vont dans .data/replies.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stockage des photos jointes aux réponses. Créer un store Vercel Blob
# (Vercel > Storage > Create Database > Blob) : la variable est ajoutée
# automatiquement. Sans elle, elle peut répondre par texte mais pas joindre
# de photo, même en local — copie-la ici pour tester l'upload en dev.
BLOB_READ_WRITE_TOKEN=

# Dev uniquement : simule une date pour prévisualiser un jour (ignoré en production).
# FAKE_TODAY=2026-09-25
