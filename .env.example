# Copie ce fichier en .env.local (dev) et renseigne les mêmes variables dans Vercel (prod).

# Stockage de ses réponses (prod). Créer une base gratuite Upstash Redis
# (Vercel > Storage > Upstash) : les deux variables sont ajoutées automatiquement.
# En dev, sans ces variables, les réponses vont dans .data/replies.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stockage des photos jointes aux réponses. Créer un store Vercel Blob
# (Vercel > Storage > Create Database > Blob) : la variable est ajoutée
# automatiquement. Sans elle, elle peut répondre par texte mais pas joindre
# de photo, même en local — copie-la ici pour tester l'upload en dev.
BLOB_READ_WRITE_TOKEN=

# Notifications push (PWA). Générer une paire de clés une seule fois :
#   npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY est publique (elle part dans le JavaScript du site) ;
# VAPID_PRIVATE_KEY doit rester secrète, ne jamais l'exposer côté client.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optionnel : un contact pour le protocole VAPID, ex. mailto:toi@exemple.com
# VAPID_SUBJECT=

# Protège l'endpoint /api/cron/notify contre les appels extérieurs. Vercel
# l'envoie automatiquement en en-tête Authorization pour ses propres Cron Jobs
# dès que cette variable est définie sur le projet — choisis une valeur longue
# et aléatoire, ex. `openssl rand -hex 24`.
CRON_SECRET=

# Dev uniquement : simule une date pour prévisualiser un jour (ignoré en production).
# FAKE_TODAY=2026-09-25
